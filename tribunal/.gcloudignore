# .gcloudignore for the re-homed Tribunal engine (Phase 13, D-01).
# Files excluded from the Cloud Build source archive when running
# `gcloud builds submit` from the tribunal/ tree.
# The Dockerfiles only need: requirements.txt + nestor_pulse_sdk/ (+ nestor_pulse/secrets.py).
# Excluding large/local/secret paths keeps the upload fast and prevents
# local secrets or caches from leaking into the build context (T-13-03).

# Version control
.git/
.gitignore

# Virtual environments (large, not needed -- Docker installs deps from scratch)
.venv/
venv/
.venv-*/
node_modules/

# Secrets and credentials (never in build context -- T-13-03)
.env
*.env
**/*.env
*.key
*.pem
secrets/

# Planning, docs, agent config (not needed in container)
.planning/
.claude/
.agents/

# Test artifacts and caches
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
*.egg-info/

# Local build artifacts (regenerated by build-and-push.sh at deploy time -- Plan 03)
infrastructure/cloud-run/.last-build.env
