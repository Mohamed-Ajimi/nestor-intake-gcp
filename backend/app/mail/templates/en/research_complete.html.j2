{#
  Research-complete notification (EN) — RUN-02 / D-10 / D-11.
  Short body: "research is done" + duration + cost + ONE admin CTA.
  NOTIF-01: cta_url = {app_base_url}/admin/pulse/intakes/{intake_id} — no token.
  autoescape ON (T-16-05); never `| safe`.
#}{% extends "_base.html.j2" %}
{% block tag %}Nestor Pulse — Research{% endblock %}
{% block content %}
<h1>The research is done</h1>
<p>The research for <strong>{{ project_title }}</strong> is complete.</p>
<ul>
  {% if duration_min is not none %}<li>Duration: {{ duration_min }} min</li>{% endif %}
  {% if cost_usd is not none %}<li>Cost: ${{ cost_usd }}</li>{% endif %}
</ul>
<p style="margin-top: 24px;"><a href="{{ cta_url }}" class="btn">Open research in admin →</a></p>
{% endblock %}
